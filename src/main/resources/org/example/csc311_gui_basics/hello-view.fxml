<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Hyperlink?>
<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.csc311_gui_basics.HelloController" stylesheets="@styles.css">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="Enter your name:" styleClass="prompt-label" rotate="5.0"/>
    <TextField fx:id="nameField" promptText="Your name" styleClass="name-field"/>
    <HBox spacing="10.0" alignment="CENTER">
        <Button text="Submit" onAction="#onHelloButtonClick" styleClass="primary-button"/>
        <Label fx:id="greetingLabel" text="" rotate="15.0" styleClass="greeting-label"/>
    </HBox>

    <HBox spacing="15.0" alignment="CENTER">
        <ImageView fx:id="photoView" fitWidth="100.0" fitHeight="100.0" preserveRatio="true" styleClass="image-view">
            <image>
                <Image url="https://via.placeholder.com/100" />
            </image>
        </ImageView>
        <VBox spacing="8.0" alignment="CENTER_LEFT">
            <Button text="Change Image" onAction="#onChangeImageClick"/>
            <Button text="Clear" onAction="#onClearClick"/>
        </VBox>
    </HBox>

    <HBox spacing="10.0" alignment="CENTER">
        <CheckBox fx:id="subscribeCheck" text="Subscribe" onAction="#onSubscribeToggle"/>
        <ChoiceBox fx:id="optionsBox" onAction="#onOptionChanged"/>
    </HBox>
    <Hyperlink fx:id="subscriptionLink" text="Open FC Barcelona updates" visible="false" managed="false"/>
    <StackPane prefHeight="300.0" prefWidth="500.0">
        <TableView fx:id="statsTable" visible="false" managed="false">
            <columns>
                <TableColumn fx:id="metricColumn" text="Metric" prefWidth="300.0"/>
                <TableColumn fx:id="valueColumn" text="Value" prefWidth="180.0"/>
            </columns>
        </TableView>
        <BarChart fx:id="statsChart" visible="false" managed="false">
            <xAxis>
                <CategoryAxis label="Metric"/>
            </xAxis>
            <yAxis>
                <NumberAxis label="Value"/>
            </yAxis>
        </BarChart>
    </StackPane>
</VBox>
